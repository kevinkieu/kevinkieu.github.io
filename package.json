{
  "name": "jarvis-ai",
  "version": "1.1.76",
  "private": true,
  "description": "Jarvis AI - trợ lý AI cá nhân (PWA + Android WebView): chat đa model, live voice, RAG/Second Brain, TTS studio và Ollama local fallback.",
  "main": "bump-version.js",
  "scripts": {
    "test": "npx vitest run",
    "test:watch": "npx vitest",
    "check-models": "node scratch/check_model_registry.js",
    "smoke:openrouter": "node scratch/openrouter_nemotron_smoke.js",
    "sync-assets": "node scripts/sync-web-assets.js",
    "check-assets": "node scripts/sync-web-assets.js --check",
    "check-map": "node scripts/check-project-map.js",
    "lint": "eslint . --ext .js,.mjs,.cjs",
    "lint:fix": "eslint . --ext .js,.mjs,.cjs --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky install"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevinkieu/kevinkieu.github.io.git"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "bugs": {
    "url": "https://github.com/kevinkieu/kevinkieu.github.io/issues"
  },
  "homepage": "https://github.com/kevinkieu/kevinkieu.github.io#readme",
  "devDependencies": {
    "@vitest/coverage-v8": "^5.1.1",
    "jsdom": "^31.0.1",
    "vitest": "^5.1.1",
    "eslint": "^9.0.0",
    "@eslint/js": "^9.0.0",
    "globals": "^15.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.0.0",
    "prettier": "^3.2.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.2.0"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,json,md,html,css}": [
      "prettier --write"
    ],
    "*.{js,mjs,cjs}": [
      "eslint --fix"
    ]
  }
}
